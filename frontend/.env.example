# Vercel + Render: set this in Vercel → Project → Settings → Environment Variables (all environments
# that build the app). Value = your Render web service URL, no trailing slash.
# Leave unset for local dev (Vite proxies /api and /uploads to the backend).
# VITE_BACKEND_ORIGIN=https://your-service.onrender.com

# Android push notifications (requires google-services.json in frontend/android/app/).
# Set to true only after Firebase is configured; otherwise the app may crash on launch.
# VITE_ENABLE_PUSH=true
