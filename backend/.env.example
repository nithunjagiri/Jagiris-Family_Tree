PORT=5000
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# PostgreSQL (database: my-family, local)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=my-family

# Or use a single connection URL (recommended on Render):
# DATABASE_URL=postgresql://user:password@localhost:5432/my-family
#
# Supabase (PostgreSQL only): Project Settings → Database → copy "URI" (use pooler if you prefer).
# Include sslmode=require if not already in the URI, e.g.
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Password reset — Resend OTP (do not use WISH SMTP vars here)
# Resend: https://resend.com — free tier includes daily/monthly quotas (check Dashboard → Usage)
# RESEND_API_KEY=re_xxxx
# RESEND_FROM=onboarding@resend.dev
# Note: onboarding@resend.dev only sends TO your Resend signup email — use a verified domain for all users.
# EMAIL_FROM=...   # fallback if RESEND_FROM unset (OTP only; not for wishes)

# SMTP fallback for OTP only when RESEND_API_KEY is unset:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# Occasion wish emails (birthday / anniversary) — separate from OTP; safe alongside RESEND_API_KEY
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=nithun018@gmail.com
# SMTP_PASS=your-16-char-gmail-app-password-no-spaces
# WISH_EMAIL_FROM=Jagiri's Kutumbam <nithun018@gmail.com>

# Optional: OTP lifetime in minutes (default 15)
# PASSWORD_RESET_OTP_MINUTES=15

# Dev only: show OTP in API/UI when email is not configured (set to 0 to disable)
# PASSWORD_RESET_DEV_OTP=1

# Firebase Cloud Messaging (Android push) — optional; push is disabled when unset
# Create a Firebase project for Android package com.jagiris.app, then download the
# service account JSON (Project settings → Service accounts → Generate new private key).
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
